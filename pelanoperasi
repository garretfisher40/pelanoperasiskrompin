                              <span className="shrink-0 text-slate-400">
                                {isImage ? <ImageIcon className="w-4 h-4 text-emerald-600" /> : isPdf ? <FileText className="w-4 h-4 text-rose-600" /> : <FileText className="w-4 h-4 text-sky-600" />}
