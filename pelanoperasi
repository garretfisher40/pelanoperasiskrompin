              <div className="p-2.5 bg-white border-t border-slate-200 flex justify-end">
                <button
                  onClick={() => setModalPreviewFile(null)}
                  className="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded"
                >
                  Tutup Pratonton
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

